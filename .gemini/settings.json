{
    "mcpServers": {
        "herd": {
            "args": [
                "/Applications/Herd.app/Contents/Resources/herd-mcp.phar"
            ],
            "command": "php",
            "env": {
                "SITE_PATH": "/Users/aminjon/Herd/geoblog"
            }
        },
        "laravel-boost": {
            "args": [
                "artisan",
                "boost:mcp"
            ],
            "command": "php"
        },
        "lerd": {
            "args": [
                "mcp"
            ],
            "command": "lerd"
        }
    }
}
